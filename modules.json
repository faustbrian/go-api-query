          "testing-and-conformance"
        ],
        "responsibility": "Compile declared API query capabilities into immutable, bounded, storage-neutral plans and adapt reviewed plans to explicit transport, validation, and persistence boundaries.",
        "non_goals": [
          "Act as an ORM, query executor, SQL language, repository, or database abstraction.",
          "Own application authorization, mandatory tenant constraints, transport policy, or persistence lifecycle.",
          "Accept client-supplied identifiers, joins, functions, regular expressions, or execution behavior."
        ],
        "public_package_identifier": "apiquery",
        "primary_entry_packages": [
          "github.com/faustbrian/go-api-query"
        ],
        "package_selection": {
          "github.com/faustbrian/go-api-query": "Use for declaring bounded query capabilities and compiling authorized transport-neutral requests into immutable plans.",
          "github.com/faustbrian/go-api-query/apiqueryhttp": "Use to parse the repository's strict conventional HTTP query representation before core compilation.",
          "github.com/faustbrian/go-api-query/apiqueryjsonapi": "Use to map validated JSON:API query members into the transport-neutral request model.",
          "github.com/faustbrian/go-api-query/apiquerypgx": "Use to compile reviewed plans into allowlisted PostgreSQL query fragments without executing them.",
          "github.com/faustbrian/go-api-query/apiqueryrpc": "Use to parse bounded JSON-RPC parameters and describe the optional OpenRPC query content.",
          "github.com/faustbrian/go-api-query/apiquerytest": "Use in tests for deterministic builders, fixtures, assertions, and cross-transport conformance.",
          "github.com/faustbrian/go-api-query/apiqueryvalidation": "Use to translate query violations into immutable go-validation reports.",
          "github.com/faustbrian/go-api-query/cursor": "Use for bounded authenticated cursor encoding, rotation, expiry, and replay policy."
        },
